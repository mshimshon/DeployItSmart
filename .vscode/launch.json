{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DeployItSmart (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/DeployItSmart.dll",
            "args": [
                "${input:pickCommand}",
                "--output",
                "C:\\Users\\Administrator\\source\\repos\\DeployItSmart\\.bin",
                // "--projects",
                // "src\\DeployItSmart.csproj",
                "--linkCommits",
                "--nonLinearMasterFix",
                // "--previewMode",
                // "--allowUnsafeVersionFromSinceTag",
                // "--sinceTag",
                // "0.0.1"
            ],
            "cwd": "${input:targetRepository}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Install Local Test Version",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "tool",
                "list",
                "-g"
            ], // Quickly displays help text and exits instantly
            "preLaunchTask": "Install Local Tool Test" // 👈 Triggers your custom .NET tool pack/install task
        }
    ],
    "inputs": [
        {
            "id": "pickCommand",
            "type": "pickString",
            "description": "Select the command to test",
            "options": [
                "GenerateChangeLogRunner",
                "GetCommitInfoSinceRunner",
                "GenerateCustomConfigRunner",
                "GetTrackCommitMessagesRunner",
                "LocalTrashCommitCleanerRunner",
                "GetCurrentReleaseVersionRunner",
                "GetCurrentPreReleaseVersionRunner",
                "CalculateNextReleaseVersionRunner",
            ],
            "default": "CalculateNextReleaseVersionRunner"
        },
        {
            "id": "targetRepository",
            "type": "promptString",
            "description": "Target working directory",
            "default": "${workspaceFolder}"
        }
    ]
}
