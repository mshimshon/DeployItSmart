{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Act Workflow Hotfix Build",
            "command": "act",
            "type": "shell",
            "args": [
                "pull_request",
                "-W",
                ".github/workflows/gh_pr_main_preview.yml",
                "--artifact-server-path",
                ".\\.bin\\.artifacts",
                "-e",
                ".github/workflows/event-dev.json",
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Act Workflow Testing",
            "command": "act",
            "type": "shell",
            "args": [
                "workflow_dispatch",
                "-W",
                ".github/workflows/deploy.yml",
                "-e",
                ".github/workflows/event.json",
                "--artifact-server-path",
                ".\\.bin\\.artifacts",
            ],
            "problemMatcher": "$msCompile",
            "dependsOn": [
                "Act Workflow Hotfix Build",
            ],
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/DeployItSmart.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Pack Local Test Tool",
            "command": "dotnet",
            "type": "process",
            "args": [
                "pack",
                "${workspaceFolder}/src/DeployItSmart.csproj",
                "-c",
                "Debug",
                "/p:DebugType=portable",
                "/p:CopyOutputSymbolsToPublishDirectory=true",
                "-o",
                "${workspaceFolder}/.bin/pack"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Uninstall DeployItSmart",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "tool",
                "uninstall",
                "-g",
                "DeployItSmart",
                "||",
                "true"
            ],
            "problemMatcher": "$msCompile",
        },
        {
            "label": "Clearing Tool Cache",
            "command": "dotnet",
            "type": "process",
            "args": [
                "nuget",
                "locals",
                "all",
                "--clear",
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Install Tool from Local Pack",
            "command": "dotnet",
            "type": "process",
            "args": [
                "tool",
                "install",
                "-g",
                "DeployItSmart",
                "--add-source",
                "${workspaceFolder}/.bin/pack",
                "--version",
                "0.0.1",
                "--no-cache"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Install Local Tool Test",
            "dependsOrder": "sequence", // Ensures child tasks run one after another
            "dependsOn": [
                "Pack Local Test Tool",
                "Uninstall DeployItSmart",
                "Clearing Tool Cache",
                "Install Tool from Local Pack",
            ],
            "problemMatcher": []
        }
    ]
}
