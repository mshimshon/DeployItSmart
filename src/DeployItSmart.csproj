<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>depitsmart</ToolCommandName>
    <PackageId>DeployItSmart</PackageId>
    <!-- Configure as a Single-File App -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Configure as Self-Contained -->
    <SelfContained>true</SelfContained>
    <!-- License Configuration -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>

    <!-- Readme Configuration -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grynwald.MarkdownGenerator" Version="3.0.106" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
  </ItemGroup>
</Project>
